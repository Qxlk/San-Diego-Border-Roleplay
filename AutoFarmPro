local function getSeller()
    local npc = ws:FindFirstChild("NPC")
    return npc and npc:FindFirstChild("Seller4")
end

local function getLaunderTrigger()
    local prompts = ws:FindFirstChild("LaunderPrompts")
    local trigger = prompts and prompts:FindFirstChild("LaunderTrigger")
    return trigger and trigger:FindFirstChild("PromptPart")
end

local p2 = Vector3.new(6815.72, 17.34, 99.78)
local p3 = Vector3.new(262.51, 17.34, 88.56)
local p4 = Vector3.new(260.52, 17.36, -44.73)
local p5 = Vector3.new(208.70, 17.36, -46.10)
